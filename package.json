{
  "name": "@haema/core",
  "version": "0.1.0",
  "private": true,
  "description": "Haema — AI memory management system. An artificial hippocampus for AI.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "server:solo": "node --disable-warning=ExperimentalWarning --experimental-strip-types tools/solo-server.ts",
    "server": "node --disable-warning=ExperimentalWarning --experimental-strip-types local-server/server.ts",
    "console": "node --disable-warning=ExperimentalWarning --experimental-strip-types tools/console.ts",
    "test": "node --disable-warning=ExperimentalWarning --experimental-strip-types --test tests/adapter-contract.test.ts tests/file-adapter.test.ts tests/recall.test.ts tests/integration.test.ts",
    "typecheck": "tsc --noEmit",
    "seed": "node --disable-warning=ExperimentalWarning --experimental-strip-types tools/seed.ts",
    "test:firebase": "npm --prefix functions test && node --test firebase-client/*.test.mjs",
    "test:firebase:m2": "node --disable-warning=ExperimentalWarning --experimental-strip-types --test functions/m2.test.ts",
    "server:firebase": "node --env-file=.env.firebase-proxy --import ./firebase-client/register.mjs --disable-warning=ExperimentalWarning --experimental-strip-types local-server/server.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.24.0",
    "@google/generative-ai": "^0.21.0",
    "groq-sdk": "^0.20.0",
    "openai": "^7.10.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.4",
    "typescript": "^5.9.3"
  }
}
